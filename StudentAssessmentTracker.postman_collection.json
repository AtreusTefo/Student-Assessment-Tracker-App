          "name": "Update Teacher",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idPassportNo\": \"AB1234567\",\n  \"firstName\": \"Alice\",\n  \"lastName\": \"Johnson\",\n  \"email\": \"alice.johnson@example.com\",\n  \"phone\": \"55512345\",\n  \"subjectId\": 12,\n  \"password\": \"Pass@123\",\n  \"enrollmentDate\": \"2024-02-01T00:00:00Z\"\n}",
