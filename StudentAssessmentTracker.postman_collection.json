                "teachers",
                "{{teacherId}}"
              ]
            },
            "description": "Returns 200 with { message: 'Teacher with ID {id} successfully deleted.' } on success, or 404 if not found. Cannot delete a teacher who still has students assigned (RESTRICT FK)."
