            },
            "url": {
              "raw": "{{baseUrl}}/api/students/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "students", "login"]
            },
            "description": "Returns JWT + student profile. Token is auto-saved to {{studentToken}}."
          },
          "response": []
        }
      ]
