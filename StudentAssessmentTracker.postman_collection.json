            "url": {
              "raw": "{{baseUrl}}/api/students/{{studentId}}/teachers",
              "host": ["{{baseUrl}}"],
              "path": ["api", "students", "{{studentId}}", "teachers"]
            },
            "description": "Removes the authenticated teacher's assignment from the student."
          },
          "response": []
