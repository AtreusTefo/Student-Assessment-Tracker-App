{
  "info": {
    "_postman_id": "a3f2c1d4-b5e6-4789-abcd-ef1234567890",
    "name": "Student Assessment Tracker API",
    "description": "Complete API testing collection.\n\n**Workflow:**\n1. Run **Auth / Teacher Login** â†’ `{{teacherToken}}` is saved automatically.\n2. Run **Auth / Admin Login** â†’ `{{adminToken}}` is saved automatically.\n3. Student must first call **Auth / Student Activate**, then **Auth / Student Login** â†’ `{{studentToken}}` saved.\n4. All other requests use the stored tokens â€” no manual copy-paste needed.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "description": "Login endpoints â€” run these first to populate token variables.",
      "item": [
        {
          "name": "Teacher Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.token) {",
                  "  pm.environment.set('teacherToken', json.token);",
                  "  if (json.teacher && json.teacher.teacherId) {",
                  "    pm.environment.set('teacherId', json.teacher.teacherId);",
                  "  }",
                  "  pm.test('Teacher token saved', () => pm.expect(json.token).to.be.a('string'));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alice.johnson@example.com\",\n  \"password\": \"Pass@123\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/teachers/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "teachers", "login"]
            },
            "description": "Returns JWT + teacher profile. Token is auto-saved to {{teacherToken}}."
          },
          "response": []
        },
        {
          "name": "Admin Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.token) {",
                  "  pm.environment.set('adminToken', json.token);",
                  "  if (json.admin && json.admin.id) {",
                  "    pm.environment.set('adminId', json.admin.id);",
                  "  }",
                  "  pm.test('Admin token saved', () => pm.expect(json.token).to.be.a('string'));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@school.com\",\n  \"password\": \"Admin@123\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/admins/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admins", "login"]
            },
            "description": "Returns JWT + admin profile. Token is auto-saved to {{adminToken}}."
          },
          "response": []
        },
        {
          "name": "Student Activate (first-time)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"studentUniqueId\": \"STU-XXXXXXXX\",\n  \"email\": \"student@example.com\",\n  \"password\": \"Stud@123\",\n  \"confirmPassword\": \"Stud@123\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/students/activate",
              "host": ["{{baseUrl}}"],
              "path": ["api", "students", "activate"]
            },
            "description": "One-time activation. Replace studentUniqueId with the value from GET /api/students/{id}."
          },
          "response": []
        },
        {
          "name": "Student Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.token) {",
                  "  pm.environment.set('studentToken', json.token);",
                  "  if (json.student && json.student.id) {",
                  "    pm.environment.set('studentId', json.student.id);",
