        {
          "name": "Register Teacher",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idPassportNo\": \"AB1234567\",\n  \"firstName\": \"Alice\",\n  \"lastName\": \"Johnson\",\n  \"email\": \"alice.johnson@example.com\",\n  \"phone\": \"55512345\",\n  \"subjectId\": 8,\n  \"password\": \"Pass@123\",\n  \"enrollmentDate\": \"2024-01-15T00:00:00Z\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/teachers",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "teachers"
              ]
            },
            "description": "Registers a new teacher. idPassportNo must be exactly 9 alphanumeric characters (letters and digits only). subjectId must be a valid ID from GET /api/subjects. Phone must be exactly 8 digits. Password minimum 6 characters.\n\nSubject IDs:\n1=Accounting, 2=Art, 3=Business Studies, 4=English, 5=Geography, 6=History, 7=ICT, 8=Mathematics, 9=Multimedia, 10=Music, 11=Physical Education, 12=Science"
          },
          "response": []
        },
