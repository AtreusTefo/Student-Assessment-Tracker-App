    {
      "name": "Assessment Submissions",
      "description": "Nested under /api/students/{studentId}/assessments/{assessmentId}/submissions.\nUpload requires Student JWT. Download/list requires Teacher JWT.",
      "item": [
        {
          "name": "Upload Submission (Student)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var json = pm.response.json();",
                  "if ((pm.response.code === 200 || pm.response.code === 201) && json.id) {",
                  "  pm.environment.set('submissionId', json.id);",
                  "  pm.test('submissionId saved', () => pm.expect(json.id).to.be.a('number'));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{studentToken}}" }],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "",
                  "description": "Select a file (PDF, DOC, DOCX, JPG, PNG â€” max 10 MB)"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/students/{{studentId}}/assessments/{{assessmentId}}/submissions",
              "host": ["{{baseUrl}}"],
              "path": ["api", "students", "{{studentId}}", "assessments", "{{assessmentId}}", "submissions"]
            },
            "description": "Student uploads a submission file. studentId must match the authenticated student's ID. Accepts PDF, DOC, DOCX, JPG, PNG up to 10 MB."
          },
          "response": []
        },
        {
          "name": "Get All Submissions (Teacher)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{teacherToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/students/{{studentId}}/assessments/{{assessmentId}}/submissions",
              "host": ["{{baseUrl}}"],
              "path": ["api", "students", "{{studentId}}", "assessments", "{{assessmentId}}", "submissions"]
            },
            "description": "Lists all submission files for the given assessment."
          },
          "response": []
        },
        {
          "name": "Download Submission",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{teacherToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/students/{{studentId}}/assessments/{{assessmentId}}/submissions/{{submissionId}}/download",
              "host": ["{{baseUrl}}"],
              "path": ["api", "students", "{{studentId}}", "assessments", "{{assessmentId}}", "submissions", "{{submissionId}}", "download"]
            },
            "description": "Downloads the submission file. Teacher or the owning student may download."
          },
          "response": []
        },
        {
          "name": "Delete Submission",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{teacherToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/students/{{studentId}}/assessments/{{assessmentId}}/submissions/{{submissionId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "students", "{{studentId}}", "assessments", "{{assessmentId}}", "submissions", "{{submissionId}}"]
            },
            "description": "Deletes a submission. Teacher or the owning student may delete."
          },
          "response": []
        }
      ]
