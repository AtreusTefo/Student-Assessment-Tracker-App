    {
      "name": "Students",
      "description": "All endpoints require Teacher JWT ({{teacherToken}}). Results are scoped to the authenticated teacher.",
      "item": [
        {
          "name": "Get All Students",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{teacherToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/students",
              "host": ["{{baseUrl}}"],
              "path": ["api", "students"]
